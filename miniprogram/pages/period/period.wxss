.container {
  padding: 0;
  background-color: #ffffff;
  min-height: 100vh;
}

.calendar-header {
  padding: 32rpx 40rpx;
  display: flex;
  justify-content: center;
}

.month-selector {
  display: flex;
  align-items: center;
  gap: 32rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.arrow {
  color: #9CA3AF;
  font-size: 40rpx;
  padding: 0 20rpx;
}

.weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  color: #9CA3AF;
  font-size: 24rpx;
  padding: 20rpx 0;
}

.days-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  row-gap: 24rpx;
  padding: 0 10rpx 40rpx 10rpx;
}

.day-cell {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 80rpx;
}

.day-box {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  font-size: 30rpx;
  color: #1F2937;
}

.day-box.period { background-color: #F43F5E; color: white; }
.day-box.predict { background-color: #FFE4E6; color: #F43F5E; }
.day-box.ovulation { background-color: #DBEAFE; color: #3B82F6; }
.day-box.ovulation-day { background-color: #3B82F6; color: white; }
.day-box.today { border: 2rpx solid #3B82F6; color: #3B82F6; }
.day-box.period.today { border-color: white; color: white; }

.legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  padding: 20rpx;
  font-size: 20rpx;
  color: #6B7280;
}

.legend-item { display: flex; align-items: center; gap: 8rpx; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.dot.period { background-color: #F43F5E; }
.dot.predict { background-color: #FFE4E6; }
.dot.ovulation { background-color: #DBEAFE; }
.dot.ovulation-day { background-color: #3B82F6; }

.info-card {
  margin: 40rpx;
  background-color: #F9FAFB;
  border-radius: 24rpx;
  padding: 40rpx;
}

.border-t { border-top: 2rpx solid #E5E7EB; }
.flex-row { display: flex; flex-direction: row; }
.justify-between { justify-content: space-between; }
.items-center { align-items: center; }
.text-lg { font-size: 32rpx; }
.font-bold { font-weight: bold; }
.text-textSub { color: #6B7280; font-size: 28rpx; }
.mb-4 { margin-bottom: 32rpx; }
.pt-4 { padding-top: 32rpx; }
.pt-3 { padding-top: 24rpx; }