.container {
  padding: 0;
  background-color: #ffffff;
  min-height: 100vh;
}

.calendar-header {
  padding: 32rpx 40rpx;
  display: flex;
  justify-content: center;
}

.month-selector {
  display: flex;
  align-items: center;
  gap: 32rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.arrow {
  color: #9CA3AF;
  font-size: 40rpx;
  padding: 0 20rpx;
}

.weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  color: #9CA3AF;
  font-size: 24rpx;
  padding: 20rpx 0;
}

.days-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  row-gap: 24rpx;
  padding: 0 10rpx 40rpx 10rpx;
}

.day-cell {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 96rpx;
}

.day-box {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: 20rpx;
  position: relative;
  background-color: #F9FAFB;
  color: #1F2937;
}

.day-num {
  font-size: 28rpx;
  font-weight: 500;
}

.day-box.today { 
  border: 2rpx solid #F59E0B;
  color: #F59E0B;
}

.day-box.has-record {
  background-color: #FEF3C7;
  color: #D97706;
}

.record-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background-color: #F59E0B;
  color: white;
  font-size: 18rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  border: 2rpx solid white;
}

.info-card {
  margin: 40rpx;
  padding: 40rpx;
}
.text-center { text-align: center; }
.text-textSub { color: #6B7280; }
.text-sm { font-size: 28rpx; }