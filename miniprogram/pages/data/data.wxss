.header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(249, 250, 251, 0.9);
  backdrop-filter: blur(12px);
  padding: 0 40rpx 20rpx 40rpx;
}
.main-content { padding: 40rpx; }

.chart-container {
  position: relative;
  height: 400rpx;
  display: flex;
  padding-bottom: 40rpx;
  margin-top: 20rpx;
}

.bars-area {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
}

.bar-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  width: 60rpx;
  position: relative;
}

.bar-wrapper {
  height: 320rpx;
  width: 16rpx;
  background: rgba(0,0,0,0.03);
  border-radius: 8rpx;
  display: flex;
  align-items: flex-end;
  margin-bottom: 12rpx;
}

.bar-fill {
  width: 100%;
  border-radius: 8rpx;
  transition: height 0.5s ease-out;
  position: relative;
}

.bg-green { background: var(--primary); }
.bg-orange { background: #F59E0B; }

.bar-label {
  font-size: 20rpx;
  color: var(--text-sub);
  position: absolute;
  bottom: -40rpx;
  white-space: nowrap;
}

.summary-card {
  display: flex;
  justify-content: space-between;
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.summary-item {
  flex: 1;
  text-align: center;
}

.divider-v {
  width: 2rpx;
  background-color: #E5E7EB;
  margin: 10rpx 0;
}

.bar-value {
  position: absolute;
  top: -36rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  font-weight: bold;
  white-space: nowrap;
}

/* 新增：周期热量缺口横幅与运动柱状图样式 */
.deficit-banner {
  background: linear-gradient(135deg, #111827 0%, #374151 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.1);
}

.text-white { color: #FFFFFF; }
.opacity-80 { opacity: 0.8; }
.mt-6 { margin-top: 48rpx; }

.text-blue { color: #3B82F6; }
.bg-blue { background: #3B82F6; }