.header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(249, 250, 251, 0.9);
  backdrop-filter: blur(12px);
  padding: 0 40rpx 20rpx 40rpx;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
}

.avatar-container {
  position: relative;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.avatar-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 24rpx;
  height: 24rpx;
  background-color: var(--primary);
  border-radius: 12rpx;
  border: 4rpx solid #FFFFFF;
}

.main-content {
  padding: 40rpx;
}

.tag-primary {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  background-color: var(--primary-light);
  color: var(--primary-dark);
  border-radius: 20rpx;
  font-weight: 500;
}

.emoji-icon {
  margin-right: 8rpx;
}
.emoji-icon.sm {
  font-size: 20rpx;
}

/* 圆环简易实现 */
.ring-container {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.ring-bg {
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.ring-inner {
  width: 310rpx;
  height: 310rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.divider-v {
  width: 2rpx;
  background-color: #F3F4F6;
  margin: 10rpx 0;
}

.border-t-dashed {
  border-top: 1rpx dashed #E5E7EB;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 32rpx;
}

.stat-item {
  border-radius: 16rpx;
  padding: 16rpx 12rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.bg-blue-light { background-color: #EFF6FF; }
.bg-rose-light { background-color: #FFF1F2; }

.section {
  margin-bottom: 48rpx;
}

/* 列表项 */
.record-item {
  display: flex;
  align-items: center;
  background-color: var(--card-white);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
  border: 1rpx solid #F3F4F6;
}

.record-item.dashed {
  border: 1rpx dashed #D1D5DB;
  opacity: 0.8;
}

.icon-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
}
.bg-orange { background-color: #FFF7ED; }
.bg-gray { background-color: #F9FAFB; }

.time-tag {
  font-size: 18rpx;
  background-color: #F3F4F6;
  color: var(--text-sub);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.add-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background-color: var(--primary-light);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 350rpx;
}

.swipe-btn-edit {
  background-color: var(--primary-light) !important;
  color: var(--primary) !important;
  width: 140rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.swipe-btn-delete {
  background-color: #FEF2F2 !important;
  color: #EF4444 !important;
  width: 140rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  border-top-right-radius: 28rpx;
  border-bottom-right-radius: 28rpx;
}

/* 习惯打卡 */
.habit-card {
  background-color: var(--card-white);
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
  position: relative;
  overflow: hidden;
}

.habit-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.border-blue { border: 1rpx solid rgba(59, 130, 246, 0.2); }
.border-purple { border: 1rpx solid rgba(139, 92, 246, 0.2); }
.border-rose { border: 1rpx solid rgba(244, 63, 94, 0.2); }
.border-indigo { border: 1rpx solid rgba(99, 102, 241, 0.2); }
.border-amber { border: 1rpx solid rgba(245, 158, 11, 0.2); }

.text-blue { color: #3B82F6; }
.text-purple { color: #A855F7; }
.text-rose { color: #F43F5E; }
.text-indigo { color: #6366F1; }
.text-amber { color: #F59E0B; }

.habit-icon {
  font-size: 36rpx;
  margin-bottom: 16rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background-color: #FFFFFF;
  width: 80%;
  border-radius: 48rpx;
  padding: 48rpx;
  box-sizing: border-box;
}

.modal-input {
  background-color: #F9FAFB;
  height: 96rpx;
  border-radius: 24rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-weight: bold;
  font-size: 30rpx;
}

.btn-cancel {
  background-color: #F9FAFB;
  color: var(--text-sub);
}

.btn-confirm {
  background-color: var(--primary);
  color: #FFFFFF;
}
