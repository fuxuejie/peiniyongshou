.modal-overlay {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  align-items: flex-end;
  justify-content: center;
}

.modal-overlay.show {
  display: flex;
}

.modal-container {
  background: white;
  border-radius: 48rpx 48rpx 0 0;
  display: flex;
  flex-direction: column;
}

.modal-scroll-area {
  width: 100%;
}

.modal-content {
  padding: 48rpx 40rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.modal-footer {
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: white;
  border-top: 2rpx solid #F3F4F6;
  flex-shrink: 0;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.p-6 { padding: 48rpx; }
.mb-1 { margin-bottom: 8rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-4 { margin-bottom: 32rpx; }
.mb-5 { margin-bottom: 40rpx; }
.mt-1 { margin-top: 8rpx; }
.mt-3 { margin-top: 24rpx; }
.pt-3 { padding-top: 24rpx; }
.my-6 { margin: 48rpx 0; }

.text-center { text-align: center; }
.text-right { text-align: right; }
.font-bold { font-weight: bold; }
.font-extrabold { font-weight: 800; }
.font-medium { font-weight: 500; }

.text-xs { font-size: 24rpx; }
.text-sm { font-size: 28rpx; }
.text-lg { font-size: 36rpx; }
.text-xl { font-size: 48rpx; }

.text-textMain { color: var(--text-main, #1F2937); }
.text-textSub { color: var(--text-sub, #6B7280); }
.text-textLight { color: var(--text-light, #9CA3AF); }
.text-primary { color: var(--primary, #10B981); }

.flex-row { display: flex; flex-direction: row; }
.flex-1 { flex: 1; }
.items-center { align-items: center; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }
.gap-2 { gap: 16rpx; }
.gap-3 { gap: 24rpx; }
.gap-4 { gap: 32rpx; }

.drag-bar {
  width: 80rpx;
  height: 8rpx;
  background-color: #E5E7EB;
  border-radius: 4rpx;
  margin: 0 auto 40rpx auto;
}

.btn-box {
  background: linear-gradient(to bottom right, #D1FAE5, #F0FDF4);
  border-radius: 32rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.btn-box.border-primary { border: 2rpx solid rgba(16, 185, 129, 0.1); }
.btn-box.border-blue { 
  background: linear-gradient(to bottom right, #EFF6FF, #EEF2FF);
  border: 2rpx solid rgba(59, 130, 246, 0.1); 
}

.icon-circle {
  width: 112rpx;
  height: 112rpx;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.text-blue { color: #3B82F6; }
.text-amber { color: #F59E0B; }
.text-rose { color: #F43F5E; }

.input-container {
  background-color: #F9FAFB;
  border-radius: 32rpx;
  padding: 24rpx;
  border: 2rpx solid #F3F4F6;
}
.image-upload-box {
  width: 140rpx;
  height: 140rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #D1D5DB;
  flex-shrink: 0;
}
.image-preview-box {
  width: 140rpx;
  height: 140rpx;
  border-radius: 24rpx;
  position: relative;
  flex-shrink: 0;
}
.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}
.delete-img-btn {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0,0,0,0.6);
  color: white;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  z-index: 10;
}
.textarea {
  height: 140rpx;
  padding: 8rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--text-main);
  background: transparent;
}
.placeholder { color: #9CA3AF; }

.send-btn {
  padding: 16rpx 40rpx;
  background-color: var(--primary);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.2);
}

.candidate-tabs-scroll {
  width: 100%;
  white-space: nowrap;
}
.candidate-tabs {
  display: inline-flex;
  flex-direction: row;
  gap: 16rpx;
}
.candidate-tab {
  padding: 12rpx 32rpx;
  background-color: #F3F4F6;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  border: 2rpx solid transparent;
}
.candidate-tab.active {
  background-color: #ECFDF5;
  color: var(--primary);
  border-color: rgba(16, 185, 129, 0.3);
  font-weight: bold;
}

.meal-btn {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  border: 2rpx solid #E5E7EB;
  background-color: #FFFFFF;
  color: var(--text-sub);
}
.meal-btn.active {
  border: 4rpx solid var(--primary);
  background-color: var(--primary-light);
  color: var(--primary);
  font-weight: bold;
}

.result-box {
  background: linear-gradient(to bottom right, rgba(16, 185, 129, 0.05), #ECFDF5);
  border-radius: 32rpx;
  padding: 32rpx;
  border: 2rpx solid rgba(16, 185, 129, 0.1);
}

.border-t { border-top: 2rpx solid rgba(16, 185, 129, 0.1); }

.amount-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background-color: #F3F4F6;
  color: var(--text-sub);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.submit-btn {
  width: 100%;
  padding: 28rpx 0;
  border-radius: 32rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
}

.btn-gradient {
  background: linear-gradient(135deg, #34D399 0%, #10B981 100%);
  color: white;
  box-shadow: 0 8rpx 25rpx -5rpx rgba(16, 185, 129, 0.4);
}